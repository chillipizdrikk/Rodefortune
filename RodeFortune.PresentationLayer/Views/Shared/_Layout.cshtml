<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RodeFortune</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RodeFortune.PresentationLayer.styles.css" asp-append-version="true" />
    <style>
        .btn-purple {
            color: #fff;
            background-color: #6f42c1;
            border-color: #6f42c1;
        }

            .btn-purple:hover {
                color: #fff;
                background-color: #5e35b1;
                border-color: #5e35b1;
            }

        .btn-red {
            color: #fff;
            background-color: #dc3545;
            border-color: #dc3545;
        }

            .btn-red:hover {
                color: #fff;
                background-color: #c82333;
                border-color: #c82333;
            }

        .navbar-nav {
            margin-left: auto; 
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">RodeFortune</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <ul class="navbar-nav flex-grow-1">

                        @if (!User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link btn btn-purple text-white mx-1" asp-controller="Account" asp-action="Login">Увійти в акаунт</a>
                            </li>

                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link btn btn-purple text-white mx-1" asp-controller="Horoscope" asp-action="Index">Гороскоп дня</a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link btn btn-purple text-white mx-1" asp-controller="Divination" asp-action="Cards">Карти Таро</a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle btn btn-purple text-white mx-1" href="#" id="divinationDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Ворожіння
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="divinationDropdown">
                                @if (!User.Identity.IsAuthenticated)
                                {
                                    <li><a class="dropdown-item" asp-controller="Divination" asp-action="YesNo">Так/Ні</a></li>
                                    <li><a class="dropdown-item" asp-controller="Divination" asp-action="PresentPastFuture">Минуле, Теперішнє, Майбутнє</a></li>
                                    <li><a class="dropdown-item" asp-controller="Divination" asp-action="CardOfTheDay">Карта дня</a></li>

                                }
                                else
                                {
                                    <li><a class="dropdown-item" asp-controller="Divination" asp-action="YesNo">Так/Ні</a></li>
                                    <li><a class="dropdown-item" asp-controller="Divination" asp-action="PresentPastFuture">Минуле, Теперішнє, Майбутнє</a></li>
                                    <li><a class="dropdown-item" asp-controller="Divination" asp-action="CaseActionResult">Ситуація, Дія, Результат</a></li>
                                    <li><a class="dropdown-item" asp-controller="Divination" asp-action="DreamReview">Аналіз Сновидіння</a></li>
                                    <li><a class="dropdown-item" asp-controller="Divination" asp-action="ProblemSolution">Проблема та Вирішення</a></li>
                                    <li><a class="dropdown-item" asp-controller="Divination" asp-action="CardOfTheDay">Карта дня</a></li>
                                    <li><a class="dropdown-item" asp-controller="Tarot" asp-action="Index">Яка ви карта Таро?</a></li>
                                }
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link btn btn-purple text-white mx-1" asp-controller="Blog" asp-action="Index">Блог</a>
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link btn btn-purple text-white mx-1" asp-controller="Profile" asp-action="Index">Профіль</a>
                            </li>
                        }

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="nav-link btn btn-red text-white mx-1 border-0">Вийти</button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - RodeFortune.PresentationLayer - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>