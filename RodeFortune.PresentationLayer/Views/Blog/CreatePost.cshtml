@model RodeFortune.PresentationLayer.Models.PostViewModel
@{
    ViewData["Title"] = "Створити новий допис";
}

<div class="create-post-container">
    <div class="create-post-header">
        <h1>Створити новий допис</h1>
    </div>

    <form asp-action="CreatePost" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Name" class="control-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Content" class="control-label"></label>
            <textarea asp-for="Content" class="form-control content-editor" rows="10"></textarea>
            <span asp-validation-for="Content" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ImageFile" class="control-label"></label>
            <div class="custom-file">
                <input asp-for="ImageFile" type="file" class="custom-file-input" id="customFile" accept="image/*" />
                <label class="custom-file-label" for="customFile">Оберіть файл</label>
            </div>
            <div id="imagePreview" class="mt-2" style="display: none;">
                <img id="imgPreview" src="#" alt="Preview" class="img-thumbnail" style="max-height: 200px;" />
            </div>
        </div>

        <div class="reference-section">
            <h4>Пов'язані елементи</h4>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-create">Опублікувати</button>
            <a asp-action="Index" class="btn-cancel">Скасувати</a>
        </div>
    </form>
</div>

<style>
    .create-post-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 20px;
        background-color: #f9f7fc;
        border-radius: 8px;
        box-shadow: 0 4px 12px rgba(111, 66, 193, 0.1);
    }

    .create-post-header {
        margin-bottom: 30px;
        text-align: center;
    }

    .create-post-header h1 {
        color: #6f42c1;
        font-size: 2.5rem;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .control-label {
        font-weight: 600;
        color: #5e35b1;
        margin-bottom: 6px;
        display: block;
    }

    .form-control {
        width: 100%;
        padding: 10px;
        border: 1px solid #e0d8f0;
        border-radius: 6px;
        background-color: #ffffff;
        transition: border-color 0.3s ease;
    }

    .form-control:focus {
        border-color: #9FA5ED;
        outline: none;
        box-shadow: 0 0 0 3px rgba(159, 165, 237, 0.25);
    }

    .content-editor {
        min-height: 250px;
        resize: vertical;
    }

    .reference-section {
        background-color: #f0ebf7;
        padding: 15px;
        border-radius: 6px;
        margin-bottom: 25px;
    }

    .reference-section h4 {
        color: #6f42c1;
        margin-bottom: 15px;
    }

    .custom-file {
        position: relative;
        overflow: hidden;
    }

    .custom-file-input {
        position: absolute;
        left: 0;
        top: 0;
        opacity: 0;
        width: 100%;
        height: 100%;
        cursor: pointer;
    }

    .custom-file-label {
        padding: 10px;
        background-color: #ffffff;
        border: 1px solid #e0d8f0;
        border-radius: 6px;
        cursor: pointer;
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .form-actions {
        display: flex;
        gap: 15px;
        margin-top: 30px;
    }

    .btn-create {
        background-color: #2E6F40;
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 8px;
        font-size: 16px;
        cursor: pointer;
        transition: background-color 0.3s ease;
        flex-grow: 1;
    }

    .btn-create:hover {
        background-color: #257A36;
    }

    .btn-cancel {
        background-color: #6a3cb5;
        color: white;
        text-decoration: none;
        padding: 12px 24px;
        border-radius: 8px;
        font-size: 16px;
        cursor: pointer;
        transition: background-color 0.3s ease;
        text-align: center;
        flex-grow: 1;
    }

    .btn-cancel:hover {
        background-color: #7f5fb4;
        color: white;
        text-decoration: none;
    }

    .text-danger {
        color: #D15658;
        font-size: 0.9rem;
        margin-top: 5px;
        display: block;
    }

    .alert {
        padding: 15px;
        margin-bottom: 20px;
        border-radius: 6px;
    }

    .alert-danger {
        background-color: #fbe9e9;
        color: #D15658;
        border: 1px solid #fad2d3;
    }
</style>

@section Scripts {
    <script>
        // Image preview functionality
        $(document).ready(function() {
            $('.custom-file-input').on('change', function() {
                var fileName = $(this).val().split('\\').pop();
                $(this).next('.custom-file-label').html(fileName);

                // Preview image
                if (this.files && this.files[0]) {
                    var reader = new FileReader();

                    reader.onload = function(e) {
                        $('#imgPreview').attr('src', e.target.result);
                        $('#imagePreview').show();
                    }

                    reader.readAsDataURL(this.files[0]);
                }
            });
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}